# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and configure your credentials.
# ==============================================================================

# MongoDB Connection String (e.g., Local MongoDB or MongoDB Atlas URI)
# Example Local: mongodb://localhost:27017/portfolio
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/portfolio

# Express Backend Server Port
PORT=5000

# Optional: CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Custom API URL for frontend (leave unset to use relative /api/contact)
# VITE_API_URL=http://localhost:5000/api/contact
